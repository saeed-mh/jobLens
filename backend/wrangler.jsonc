{
  "name": "job-lens-api",
  "main": "dist/worker.js",
  "compatibility_date": "2026-10-04",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "ratelimits": [
    {
      "name": "ANALYSIS_RATE_LIMITER",
      // Choose another positive integer if this namespace is already used in your account.
      "namespace_id": "1001004",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "observability": { "enabled": false }
}
