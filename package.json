{
  "name": "job-lens",
  "version": "0.3.2",
  "private": true,
  "description": "A step-by-step Chrome extension for resume and job compatibility.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "build:backend": "node scripts/build-backend.mjs",
    "typecheck:backend": "tsc --project backend/tsconfig.json --noEmit",
    "test:backend": "node scripts/build-backend.mjs && node scripts/test-backend.mjs",
    "test": "node scripts/test.mjs",
    "test:browser": "node scripts/test-browser.mjs && node scripts/test-linkedin.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "chrome-types": "0.1.451",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.4.299"
  }
}
