{
  "manifest_version": 3,
  "name": "Job Lens",
  "version": "0.3.2",
  "description": "Read the opened LinkedIn job posting and prepare local resume matching.",
  "minimum_chrome_version": "125",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["linkedin/content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; worker-src 'self'; object-src 'none'; connect-src 'self'; base-uri 'none'"
  },
  "action": {
    "default_title": "Job Lens",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
