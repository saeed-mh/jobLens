{
  "manifest_version": 3,
  "name": "Job Lens",
  "version": "0.6.12",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "description": "Compare your reviewed resume with opened LinkedIn jobs using consent-based AI matching.",
  "minimum_chrome_version": "125",
  "permissions": ["storage"],
  "host_permissions": ["https://job-lens-api.saeedmohh10.workers.dev/*"],
  "background": { "service_worker": "background/worker.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["linkedin/content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; worker-src 'self'; object-src 'none'; connect-src 'self' https://job-lens-api.saeedmohh10.workers.dev; base-uri 'none'"
  },
  "action": {
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" },
    "default_title": "Job Lens",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
